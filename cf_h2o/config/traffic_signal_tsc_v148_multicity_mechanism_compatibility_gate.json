{
  "protocol": "tsc-v148-multicity-mechanism-compatibility-gate-v1",
  "target_city_groups": [
    "atlanta",
    "cologne",
    "hangzhou",
    "ingolstadt",
    "new_york",
    "resco_synthetic",
    "salt_lake_city"
  ],
  "target_budget": 25,
  "cross_fit_folds": 5,
  "cross_fit_training_groups": 20,
  "cross_fit_scored_groups": 5,
  "scored_adaptation_labels_used": true,
  "evaluation_features_or_labels_used": false,
  "probe": {
    "estimator": "fixed-parent-rank0-domain-balanced-residual-v1",
    "parent_variant": "physical",
    "mechanisms": [
      "queue_propagation",
      "served_movement",
      "red_accumulation",
      "spillback",
      "mobility"
    ],
    "loss": "action-group-equal-mean-squared-error",
    "mechanism_trust": "clip((target_only_loss-source_plus_target_loss)/max(target_only_loss,1e-12),0,1)",
    "source_mass": "equal_mean_of_five_mechanism_trusts"
  },
  "downstream_action_model": "unchanged_v143_rigid_causal_action_ranker",
  "source_score": "target_score+source_mass*(source_score-target_score)",
  "matched_placebo_score": "target_score+source_mass*permuted_source_residual",
  "outer_label_exclusion": "heldout_city_absent_as_source_and_target",
  "selection_rule": {
    "maximum_history_regression": 0.005,
    "minimum_history_q75_improvement": 0.0005,
    "history_comparators": [
      "target_only_causal",
      "matched_source_placebo"
    ],
    "source_null_when_no_history_admission": true,
    "admitted_source_choice": "maximum_current_target_mechanism_mass_then_history_mean_then_name"
  },
  "development_gate": {
    "primary_comparators": [
      "target_only_causal",
      "pooled_h2oplus",
      "matched_source_placebo"
    ],
    "minimum_mean_improvement": 0.0005,
    "minimum_improving_cities": 5,
    "maximum_city_regression": 0.01,
    "one_sided_confidence_level": 0.95
  },
  "failure_rule": "close_mechanism_compatibility_gate_without_threshold_retuning",
  "confirmation_target": "boston_package_v11_v149_only"
}
