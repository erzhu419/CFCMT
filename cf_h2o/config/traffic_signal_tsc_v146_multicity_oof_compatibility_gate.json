{
  "protocol": "tsc-v146-multicity-oof-compatibility-gate-v1",
  "scientific_role": "post-v145-seven-city-development-not-confirmation",
  "target_city_groups": [
    "atlanta",
    "cologne",
    "hangzhou",
    "ingolstadt",
    "new_york",
    "resco_synthetic",
    "salt_lake_city"
  ],
  "target_budget": 25,
  "cross_fit_folds": 5,
  "cross_fit_training_groups": 20,
  "cross_fit_scored_groups": 5,
  "selector_information": "b20_model_predictions_on_disjoint_b5_features_and_phase_pressure_reference_only",
  "scored_adaptation_labels_used": false,
  "evaluation_features_or_labels_used": false,
  "outer_label_exclusion": "heldout_city_absent_as_source_and_target",
  "selection_rule": {
    "minimum_history_mean_improvement": 0.0005,
    "history_comparators": [
      "target_only_causal",
      "matched_source_placebo"
