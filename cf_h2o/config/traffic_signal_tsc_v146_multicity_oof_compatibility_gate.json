    "source_rank": "maximum_chance_corrected_oof_policy_compatibility_then_minimum_target_model_regret_then_history_mean",
    "source_mass": "chance_corrected_oof_action_agreement",
    "source_null": "no_positive_history_source_or_zero_trust_mass"
  },
  "development_gate": {
    "primary_comparators": [
      "target_only_causal",
      "pooled_h2oplus",
      "matched_source_placebo"
    ],
    "minimum_mean_improvement": 0.0005,
    "minimum_improving_cities": 5,
    "maximum_city_regression": 0.01,
    "one_sided_confidence": 0.95
  },
  "failure_rule": "close_oof_compatibility_source_gate_without_threshold_retuning",
  "successor_boundary": "A pass authorizes only a separately frozen untouched-city protocol."
}
